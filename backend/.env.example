PROJECT_NAME="Arthayog Dormitory ERP"
VERSION="1.0.0"
ENVIRONMENT="production"
SECRET_KEY="replace_with_a_secure_random_64_char_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite with persistent disk or PostgreSQL:
# For Render disk mounted at /var/data:
DATABASE_URL="sqlite:////var/data/arthayog.db"
# Or for PostgreSQL on Render / Supabase / Neon:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Razorpay credentials (replace with live keys from your Razorpay Dashboard)
RAZORPAY_KEY_ID="rzp_test_arthayog_sample_key"
RAZORPAY_KEY_SECRET="sample_razorpay_secret_key_12345"

# Hold timeout for unpaid bookings in minutes
BOOKING_HOLD_TIMEOUT_MINUTES=15

# Owner Initial Admin
INITIAL_OWNER_EMAIL="owner@arthayog.com"
INITIAL_OWNER_PASSWORD="AdminSecurePassword123!"
INITIAL_STAFF_EMAIL="staff@arthayog.com"
INITIAL_STAFF_PASSWORD="StaffSecurePassword123!"
